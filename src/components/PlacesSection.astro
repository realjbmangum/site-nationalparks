---
/**
 * Places Section Component
 *
 * Points of interest section with NPS data.
 * Shows notable locations within the park.
 */
import type { NPSPlace } from '../lib/nps-api';

interface Props {
  places: NPSPlace[];
  parkCode: string;
}

const { places, parkCode } = Astro.props;

// Show first 5 places
const displayPlaces = places.slice(0, 5);

// Get place category from tags
function getCategory(place: NPSPlace): string {
  if (place.tags?.length > 0) {
    // Capitalize first letter
    return place.tags[0].charAt(0).toUpperCase() + place.tags[0].slice(1);
  }
  return 'Point of Interest';
}
---

{displayPlaces.length > 0 && (
  <section class="places-section">
    <div class="section-header">
      <h2 class="section-title">Points of Interest</h2>
      {places.length > 5 && (
        <a
          href={`https://www.nps.gov/${parkCode}/planyourvisit/places.htm`}
          target="_blank"
          rel="noopener noreferrer"
          class="view-all-link"
        >
          View All {places.length}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="arrow-icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      )}
    </div>

    <div class="places-list">
      {displayPlaces.map((place, index) => {
        const category = getCategory(place);

        return (
          <a
            href={place.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`place-item ${index < displayPlaces.length - 1 ? 'border-b' : ''}`}
          >
            {place.images?.[0] ? (
              <div class="place-image">
                <img
                  src={place.images[0].url}
                  alt={place.images[0].altText || place.title}
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="place-icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="place-icon">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                </svg>
              </div>
            )}

            <div class="place-content">
              <div class="place-header">
                <h3 class="place-title">{place.title}</h3>
                <span class="place-category">{category}</span>
              </div>

              {place.listingDescription && (
                <p class="place-description">
                  {place.listingDescription.length > 120
                    ? place.listingDescription.slice(0, 120) + '...'
                    : place.listingDescription}
                </p>
              )}

              {place.isPassportStampLocation === "1" && (
                <span class="passport-badge">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="badge-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/>
                  </svg>
                  Passport Stamp
                </span>
              )}
            </div>

            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="chevron-icon">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
            </svg>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .places-section {
    margin-top: 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-display, 'Playfair Display', serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gray-900, #111827);
    margin: 0;
  }

  .view-all-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-primary, #1E4D2B);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .arrow-icon {
    width: 1rem;
    height: 1rem;
  }

  .places-list {
    background: white;
    border-radius: 0.75rem;
    border: 1px solid var(--color-gray-200, #e5e7eb);
    overflow: hidden;
  }

  .place-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .place-item:hover {
    background: var(--color-gray-50, #f9fafb);
  }

  .place-item.border-b {
    border-bottom: 1px solid var(--color-gray-200, #e5e7eb);
  }

  .place-image {
    width: 4rem;
    height: 4rem;
    border-radius: 0.5rem;
    overflow: hidden;
    flex-shrink: 0;
  }

  .place-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .place-icon-wrapper {
    width: 4rem;
    height: 4rem;
    border-radius: 0.5rem;
    background: rgba(244, 163, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .place-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-secondary, #F4A300);
  }

  .place-content {
    flex: 1;
    min-width: 0;
  }

  .place-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .place-title {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-gray-900, #111827);
    margin: 0;
  }

  .place-category {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-gray-500, #6b7280);
    background: var(--color-gray-100, #f3f4f6);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }

  .place-description {
    font-size: 0.8125rem;
    color: var(--color-gray-600, #4b5563);
    margin: 0;
    line-height: 1.4;
  }

  .passport-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-primary, #1E4D2B);
    margin-top: 0.375rem;
  }

  .badge-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .chevron-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-gray-400, #9ca3af);
    flex-shrink: 0;
  }
</style>
