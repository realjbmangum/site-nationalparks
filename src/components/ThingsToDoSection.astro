---
/**
 * Things To Do Section Component
 *
 * Enhanced activities section with NPS data.
 * Shows activity cards with duration, difficulty, and categories.
 */
import type { NPSThingToDo } from '../lib/nps-api';

interface Props {
  thingsToDo: NPSThingToDo[];
  parkCode: string;
}

const { thingsToDo, parkCode } = Astro.props;

// Show first 6 activities
const displayActivities = thingsToDo.slice(0, 6);

// Get primary activity type
function getActivityType(thing: NPSThingToDo): string {
  if (thing.activities?.length > 0) {
    return thing.activities[0].name;
  }
  if (thing.topics?.length > 0) {
    return thing.topics[0].name;
  }
  return 'Activity';
}

// Format duration
function formatDuration(thing: NPSThingToDo): string | null {
  if (thing.durationDescription) {
    // Extract just the time part if it's verbose
    const match = thing.durationDescription.match(/(\d+[-–]\d+\s*(hours?|minutes?|hrs?|mins?))/i);
    if (match) return match[1];
    if (thing.durationDescription.length < 20) return thing.durationDescription;
  }
  if (thing.duration) {
    return thing.duration;
  }
  return null;
}

// Get season badges
function getSeasons(thing: NPSThingToDo): string[] {
  return (thing.season || []).slice(0, 2);
}
---

{displayActivities.length > 0 && (
  <section class="things-to-do-section">
    <div class="section-header">
      <h2 class="section-title">Things To Do</h2>
      {thingsToDo.length > 6 && (
        <a
          href={`https://www.nps.gov/${parkCode}/planyourvisit/things2do.htm`}
          target="_blank"
          rel="noopener noreferrer"
          class="view-all-link"
        >
          View All {thingsToDo.length}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="arrow-icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        </a>
      )}
    </div>

    <div class="activities-grid">
      {displayActivities.map((thing) => {
        const activityType = getActivityType(thing);
        const duration = formatDuration(thing);
        const seasons = getSeasons(thing);

        return (
          <a
            href={thing.url}
            target="_blank"
            rel="noopener noreferrer"
            class="activity-card"
          >
            {thing.images?.[0] && (
              <div class="activity-image">
                <img
                  src={thing.images[0].url}
                  alt={thing.images[0].altText || thing.title}
                  loading="lazy"
                />
              </div>
            )}

            <div class="activity-content">
              <span class="activity-type">{activityType}</span>

              <h3 class="activity-title">{thing.title}</h3>

              {thing.shortDescription && (
                <p class="activity-description">
                  {thing.shortDescription.length > 100
                    ? thing.shortDescription.slice(0, 100) + '...'
                    : thing.shortDescription}
                </p>
              )}

              <div class="activity-meta">
                {duration && (
                  <span class="meta-item">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="meta-icon">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {duration}
                  </span>
                )}

                {seasons.length > 0 && (
                  <span class="meta-item">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="meta-icon">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                    </svg>
                    {seasons.join(', ')}
                  </span>
                )}

                {thing.isReservationRequired === "true" && (
                  <span class="reservation-badge">Reservation Required</span>
                )}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .things-to-do-section {
    margin-top: 2rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: var(--font-display, 'Playfair Display', serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gray-900, #111827);
    margin: 0;
  }

  .view-all-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-primary, #1E4D2B);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .arrow-icon {
    width: 1rem;
    height: 1rem;
  }

  .activities-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .activities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .activities-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .activity-card {
    background: white;
    border-radius: 0.75rem;
    border: 1px solid var(--color-gray-200, #e5e7eb);
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .activity-card:hover {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .activity-image {
    height: 8rem;
    overflow: hidden;
  }

  .activity-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .activity-content {
    padding: 1rem;
  }

  .activity-type {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    color: var(--color-primary, #1E4D2B);
    background: rgba(30, 77, 43, 0.1);
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .activity-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-gray-900, #111827);
    margin: 0 0 0.375rem 0;
    line-height: 1.3;
  }

  .activity-description {
    font-size: 0.8125rem;
    color: var(--color-gray-600, #4b5563);
    margin: 0 0 0.75rem 0;
    line-height: 1.4;
  }

  .activity-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-gray-500, #6b7280);
  }

  .meta-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .reservation-badge {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-secondary, #F4A300);
    background: rgba(244, 163, 0, 0.1);
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
  }
</style>
