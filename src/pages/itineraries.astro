---

<BaseLayout
  title="National Park Road Trip Itineraries - Multi-Park Routes with Day-by-Day Plans"
  description="Six epic national park road trip itineraries with detailed day-by-day routes, drive times, hiking recommendations, budget estimates, and insider tips from experienced park visitors."
>
  <!-- Hero -->
  <section class="bg-primary text-white py-16">
    <div class="container-site text-center">
      <h1 class="text-4xl md:text-5xl font-display font-bold mb-4">
        Road Trip Itineraries
      </h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto">
        Six detailed, road-tested itineraries connecting America's best national parks. Real drive times, specific hikes, and honest advice from thousands of miles on the road.
      </p>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="bg-gray-50 py-6 border-b sticky top-16 md:top-20 z-40">
    <div class="container-site">
      <div class="flex gap-3 overflow-x-auto pb-2 -mb-2">
        {itineraries.map((itin) => (
          <a
            href={`#${itin.slug}`}
            class="bg-white px-4 py-2 rounded-full text-sm font-medium text-gray-700 hover:bg-primary hover:text-white transition-colors whitespace-nowrap shadow-sm"
          >
            {itin.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-display font-bold text-gray-900 mb-4">
        How to Use These Itineraries
      </h2>
      <p class="text-gray-600 leading-relaxed">
        Every itinerary includes the exact route, daily activities, realistic drive times, and budget estimates.
        We've flagged where you need reservations, where cell service dies, and where you'll want to linger longer
        than planned. Adjust days up or down based on your pace — these routes reward slowing down.
      </p>
    </div>
  </section>

  <!-- Itineraries -->
  <section class="section-padding bg-gray-50">
    <div class="container-site">
      <div class="space-y-24">
        {itineraries.map((itin, idx) => (
          <article id={itin.slug} class="scroll-mt-32">
            <!-- Header -->
            <div class="grid lg:grid-cols-2 gap-8 mb-8">
              <div>
                <p class="text-sm font-semibold text-secondary uppercase tracking-wide mb-2">
                  Itinerary {idx + 1} of {itineraries.length}
                </p>
                <h2 class="text-3xl md:text-4xl font-display font-bold text-gray-900 mb-2">
                  {itin.title}
                </h2>
                <p class="text-lg text-primary font-medium italic mb-4">{itin.tagline}</p>
                <p class="text-gray-600 leading-relaxed mb-6">{itin.description}</p>

                <div class="grid grid-cols-2 gap-4">
                  <div class="bg-white rounded-lg p-4 shadow-sm">
                    <div class="text-sm text-gray-500">Duration</div>
                    <div class="font-semibold text-gray-900">{itin.duration}</div>
                  </div>
                  <div class="bg-white rounded-lg p-4 shadow-sm">
                    <div class="text-sm text-gray-500">Total Distance</div>
                    <div class="font-semibold text-gray-900">{itin.distance}</div>
                  </div>
                  <div class="bg-white rounded-lg p-4 shadow-sm">
                    <div class="text-sm text-gray-500">Best Season</div>
                    <div class="font-semibold text-gray-900">{itin.bestSeason}</div>
                  </div>
                  <div class="bg-white rounded-lg p-4 shadow-sm">
                    <div class="text-sm text-gray-500">Budget Estimate</div>
                    <div class="font-semibold text-gray-900">{itin.budget}</div>
                  </div>
                </div>
              </div>

              <div class="relative">
                <img
                  src={itin.image}
                  alt={itin.title}
                  class="w-full h-64 lg:h-full object-cover rounded-xl shadow-lg"
                  loading="lazy"
                />
                <div class="absolute bottom-4 left-4 right-4">
                  <div class="flex flex-wrap gap-2">
                    {itin.parks.map((park) => (
                      <a
                        href={`/parks/${park.slug}`}
                        class="bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-sm font-medium text-gray-900 shadow hover:bg-white transition-colors"
                      >
                        {park.name}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Budget Breakdown -->
            <div class="bg-secondary/10 rounded-xl p-5 mb-8">
              <div class="flex items-start gap-3">
                <span class="text-secondary font-bold text-lg">$</span>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">Budget Breakdown</h3>
                  <p class="text-sm text-gray-700">{itin.budgetBreakdown}</p>
                </div>
              </div>
            </div>

            <!-- Day by Day Route -->
            <div class="mb-8">
              <h3 class="text-2xl font-display font-bold text-gray-900 mb-6">Day-by-Day Route</h3>
              <div class="space-y-4">
                {itin.route.map((stop) => (
                  <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                    <div class="bg-primary/5 px-5 py-3 border-b border-gray-100">
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex items-center gap-3">
                          <span class="text-sm font-bold text-primary bg-primary/10 px-3 py-1 rounded-full">{stop.day}</span>
                          <span class="font-semibold text-gray-900">{stop.location}</span>
                        </div>
                        <span class="text-sm text-gray-500">{stop.driveTime}</span>
                      </div>
                    </div>
                    <div class="p-5">
                      <p class="text-gray-700 leading-relaxed mb-3">{stop.activities}</p>
                      <div class="flex items-start gap-2 bg-gray-50 rounded-lg p-3">
                        <span class="text-secondary font-bold text-sm mt-0.5">TIP</span>
                        <p class="text-sm text-gray-600">{stop.tip}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Pro Tips -->
            <div class="bg-primary/5 rounded-xl p-6">
              <h3 class="text-xl font-display font-bold text-gray-900 mb-4">Pro Tips for This Route</h3>
              <ul class="space-y-3">
                {itin.tips.map((tip) => (
                  <li class="flex items-start gap-3">
                    <span class="text-primary font-bold mt-0.5">&#10003;</span>
                    <span class="text-gray-700">{tip}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Ad -->
  <div class="container-site">
    <AdSlot slot="inline" />
  </div>

  <!-- Planning Resources -->
  <section class="bg-primary/5 section-padding">
    <div class="container-site">
      <h2 class="text-2xl font-display font-bold text-gray-900 mb-6 text-center">
        Planning Resources
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
        <a href="/guides" class="bg-white rounded-lg p-4 text-center hover:shadow-md transition-shadow">
          <div class="font-semibold text-gray-900">Planning Guides</div>
          <div class="text-sm text-gray-500">First-timer tips and more</div>
        </a>
        <a href="/gear" class="bg-white rounded-lg p-4 text-center hover:shadow-md transition-shadow">
          <div class="font-semibold text-gray-900">Gear Guide</div>
          <div class="text-sm text-gray-500">What to pack for the trail</div>
        </a>
        <a
          href="https://www.recreation.gov"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white rounded-lg p-4 text-center hover:shadow-md transition-shadow"
        >
          <div class="font-semibold text-gray-900">Recreation.gov</div>
          <div class="text-sm text-gray-500">Campground reservations</div>
        </a>
        <a href="/map" class="bg-white rounded-lg p-4 text-center hover:shadow-md transition-shadow">
          <div class="font-semibold text-gray-900">Park Map</div>
          <div class="text-sm text-gray-500">Visualize your route</div>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-white">
    <div class="container-site text-center">
      <h2 class="text-2xl font-display font-bold text-gray-900 mb-4">
        Ready to Start Planning?
      </h2>
      <p class="text-gray-600 mb-6">
        Explore all 63 national parks and find your perfect adventure.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/parks" class="btn-primary">Browse All Parks</a>
        <a href="/states" class="btn-secondary">Parks by State</a>
      </div>
    </div>
  </section>
</BaseLayout>
