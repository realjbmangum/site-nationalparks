---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRegionsWithCounts, REGIONS } from '../../lib/db';

// Get D1 database from Cloudflare runtime
const db = Astro.locals.runtime.env.DB;

// Get region counts from database
const regionCounts = await getRegionsWithCounts(db);
const countMap = Object.fromEntries(regionCounts.map(r => [r.region, r.count]));

// Combine static region data with counts
const regions = Object.values(REGIONS).map(region => ({
  ...region,
  count: countMap[region.slug] || 0,
}));
---

<BaseLayout
  title="National Parks by Region"
  description="Explore US national parks organized by region - Western US, Alaska, Southeast, Northeast, Midwest, and Islands."
>
  <section class="bg-primary text-white py-16">
    <div class="container-site text-center">
      <h1 class="text-4xl md:text-5xl font-display font-bold mb-4">
        Explore by Region
      </h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto">
        Discover America's national parks organized by geographic region
      </p>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-site">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {regions.map((region) => (
          <a
            href={`/regions/${region.slug}`}
            class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-lg"
          >
            <img
              src={region.heroImage}
              alt={`${region.name} national parks`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h2 class="text-2xl font-display font-bold text-white mb-2">
                {region.name}
              </h2>
              <p class="text-white/80 text-sm mb-2 line-clamp-2">
                {region.description}
              </p>
              <span class="inline-flex items-center gap-2 text-secondary font-medium text-sm">
                {region.count} Parks
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Alternatives -->
  <section class="py-12 bg-white">
    <div class="container-site text-center">
      <h2 class="text-2xl font-display font-bold text-gray-900 mb-4">
        Other Ways to Explore
      </h2>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/states" class="btn-secondary">Browse by State</a>
        <a href="/parks" class="btn-secondary">View All Parks</a>
        <a href="/map" class="btn-primary">Interactive Map</a>
      </div>
    </div>
  </section>
</BaseLayout>
