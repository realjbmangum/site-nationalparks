---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParkCard from '../../components/ParkCard.astro';
import { getParksByRegion, REGIONS, type RegionSlug } from '../../lib/db';

// Get D1 database from Cloudflare runtime
const db = Astro.locals.runtime.env.DB;

// Get region slug from URL
const { slug } = Astro.params;

// Validate region exists
const region = REGIONS[slug as RegionSlug];
if (!region) {
  return Astro.redirect('/404');
}

// Fetch parks for this region
const parks = await getParksByRegion(db, slug!);

// Get adjacent regions for navigation
const regionSlugs = Object.keys(REGIONS) as RegionSlug[];
const currentIndex = regionSlugs.indexOf(slug as RegionSlug);
const prevRegion = currentIndex > 0 ? REGIONS[regionSlugs[currentIndex - 1]] : null;
const nextRegion = currentIndex < regionSlugs.length - 1 ? REGIONS[regionSlugs[currentIndex + 1]] : null;

// Schema.org markup
const regionSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `National Parks in ${region.name}`,
  description: region.description,
  numberOfItems: parks.length,
  itemListElement: parks.map((park, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'TouristAttraction',
      name: `${park.name} National Park`,
      url: `https://bestusnationalparks.com/parks/${park.slug}`,
    },
  })),
};
---

<BaseLayout
  title={`${region.name} National Parks`}
  description={`Explore ${parks.length} national parks in ${region.name}. ${region.description}`}
  image={region.heroImage}
  schema={regionSchema}
>
  <!-- Hero Section -->
  <section class="relative h-[50vh] min-h-[400px] overflow-hidden">
    <img
      src={region.heroImage}
      alt={`${region.name} landscape`}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent" />

    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-12">
      <div class="container-site">
        <nav class="text-white/80 text-sm mb-4">
          <a href="/" class="hover:text-white">Home</a>
          <span class="mx-2">/</span>
          <a href="/parks" class="hover:text-white">Parks</a>
          <span class="mx-2">/</span>
          <span class="text-white">Regions</span>
        </nav>
        <h1 class="text-4xl md:text-6xl font-display font-bold text-white mb-4">
          {region.name}
        </h1>
        <p class="text-xl text-white/90 max-w-2xl">
          {region.description}
        </p>
        <p class="mt-4 text-secondary font-medium">
          {parks.length} National Park{parks.length !== 1 ? 's' : ''}
        </p>
      </div>
    </div>
  </section>

  <!-- Parks Grid -->
  <section class="section-padding bg-gray-50">
    <div class="container-site">
      {parks.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {parks.map((park) => (
            <ParkCard park={park} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-gray-600 text-lg">No parks found in this region.</p>
          <a href="/parks" class="btn-primary mt-4">View All Parks</a>
        </div>
      )}
    </div>
  </section>

  <!-- Region Navigation -->
  <section class="py-8 bg-white border-t">
    <div class="container-site">
      <div class="flex justify-between items-center">
        {prevRegion ? (
          <a
            href={`/regions/${prevRegion.slug}`}
            class="flex items-center gap-2 text-gray-600 hover:text-primary transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span class="text-sm">{prevRegion.name}</span>
          </a>
        ) : (
          <div />
        )}

        <a href="/parks" class="text-primary hover:text-primary-light font-medium">
          View All Parks
        </a>

        {nextRegion ? (
          <a
            href={`/regions/${nextRegion.slug}`}
            class="flex items-center gap-2 text-gray-600 hover:text-primary transition-colors"
          >
            <span class="text-sm">{nextRegion.name}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ) : (
          <div />
        )}
      </div>
    </div>
  </section>

  <!-- Other Regions CTA -->
  <section class="section-padding bg-primary text-white">
    <div class="container-site">
      <h2 class="text-2xl md:text-3xl font-display font-bold mb-8 text-center">
        Explore Other Regions
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {Object.values(REGIONS)
          .filter((r) => r.slug !== slug)
          .map((r) => (
            <a
              href={`/regions/${r.slug}`}
              class="bg-white/10 hover:bg-white/20 rounded-lg p-4 text-center transition-colors"
            >
              <span class="font-medium">{r.name}</span>
            </a>
          ))}
      </div>
    </div>
  </section>
</BaseLayout>
