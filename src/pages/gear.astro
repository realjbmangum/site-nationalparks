---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/site-config.json';
import AdSlot from '../components/AdSlot.astro';

const amazonTag = siteConfig.monetization?.amazonTag || '';
function amazonUrl(productName: string) {
  return `https://www.amazon.com/s?k=${encodeURIComponent(productName)}&tag=${amazonTag}`;
}

const gearCategories = [
  {
    slug: 'day-hiking',
    name: 'Day Hiking Essentials',
    icon: '🥾',
    description: 'Must-haves for any day hike in the parks.',
    items: [
      {
        name: 'Osprey Talon 22 Backpack',
        amazonSearchQuery: 'Osprey Talon 22 Hiking Daypack',
        category: 'Pack',
        why: 'Perfect size for day hikes with excellent ventilation, hipbelt pockets, and hydration compatibility. Fits most torsos comfortably.',
        priceRange: '$140-160',
        alternative: 'REI Co-op Flash 22 ($70) for budget option',
        altSearchQuery: 'REI Co-op Flash 22 Pack',
      },
      {
        name: 'Salomon X Ultra 4 GTX',
        amazonSearchQuery: 'Salomon X Ultra 4 Gore-Tex Hiking Shoes',
        category: 'Footwear',
        why: 'Best-in-class trail runners with Gore-Tex waterproofing. Light enough for speed, supportive enough for rocky terrain. Break them in before your trip.',
        priceRange: '$165-185',
        alternative: 'Merrell Moab 3 ($135) for wider feet',
        altSearchQuery: 'Merrell Moab 3 Hiking Shoes',
      },
      {
        name: 'Hydrapak Flux 1.5L',
        amazonSearchQuery: 'Hydrapak Flux 1.5L Water Reservoir',
        category: 'Hydration',
        why: 'Collapsible, durable reservoir with quick-disconnect hose. Fits any pack and rolls up when empty. BPA-free and taste-neutral.',
        priceRange: '$35-45',
        alternative: 'Nalgene 32oz bottles ($15) if you prefer bottles',
        altSearchQuery: 'Nalgene Wide Mouth 32oz Water Bottle',
      },
      {
        name: 'Black Diamond Trail Trekking Poles',
        amazonSearchQuery: 'Black Diamond Trail Cork Trekking Poles',
        category: 'Support',
        why: 'Reduces knee impact by 25% on descents. Collapsible for scrambles. Cork grips absorb sweat and mold to your hands over time.',
        priceRange: '$100-130',
        alternative: 'Cascade Mountain Tech ($35) from Costco for budget',
        altSearchQuery: 'Cascade Mountain Tech Carbon Fiber Trekking Poles',
      },
      {
        name: 'Petzl Actik Core Headlamp',
        amazonSearchQuery: 'Petzl Actik Core Rechargeable Headlamp',
        category: 'Light',
        why: '450 lumens with red light mode to preserve night vision. Rechargeable via USB-C. Always carry one even for day hikes - you never know.',
        priceRange: '$70-80',
        alternative: 'Black Diamond Spot 400 ($50)',
        altSearchQuery: 'Black Diamond Spot 400 Headlamp',
      },
      {
        name: 'Garmin inReach Mini 2',
        amazonSearchQuery: 'Garmin inReach Mini 2 Satellite Communicator',
        category: 'Safety',
        why: 'Satellite messenger for emergencies when you have no cell service. Send SOS, text loved ones, and share location. Peace of mind is priceless.',
        priceRange: '$300-400 + subscription',
        alternative: 'Zoleo ($200) for budget satellite messenger',
        altSearchQuery: 'Zoleo Satellite Communicator',
      },
    ],
  },
  {
    slug: 'camping',
    name: 'Camping Gear',
    icon: '⛺',
    description: 'Sleep well at park campgrounds.',
    items: [
      {
        name: 'Big Agnes Copper Spur HV UL2',
        amazonSearchQuery: 'Big Agnes Copper Spur HV UL2 Backpacking Tent',
        category: 'Tent',
        why: 'The gold standard for backpacking tents. Freestanding, under 3 lbs, excellent ventilation. Two doors and vestibules for easy access.',
        priceRange: '$450-500',
        alternative: 'REI Co-op Half Dome SL 2+ ($280) for car camping',
        altSearchQuery: 'REI Co-op Half Dome SL 2 Plus Tent',
      },
      {
        name: 'Nemo Tensor Insulated Sleeping Pad',
        amazonSearchQuery: 'Nemo Tensor Insulated Sleeping Pad Regular',
        category: 'Sleeping Pad',
        why: 'R-value 4.2 keeps you warm down to freezing. Quiet fabric, stable baffles, and packs down small. Integrated pump sack makes inflation easy.',
        priceRange: '$180-220',
        alternative: 'Therm-a-Rest Z Lite Sol ($50) for indestructible foam',
        altSearchQuery: 'Therm-a-Rest Z Lite Sol Sleeping Pad',
      },
      {
        name: 'Western Mountaineering UltraLite',
        amazonSearchQuery: 'Western Mountaineering UltraLite 20 Degree Sleeping Bag',
        category: 'Sleeping Bag',
        why: 'Rated to 20°F, weighs just 1 lb 13 oz. Premium 850+ fill goose down. Overstuffed for extra warmth. A lifetime investment.',
        priceRange: '$500-600',
        alternative: 'Kelty Cosmic 20 ($150) for great budget value',
        altSearchQuery: 'Kelty Cosmic 20 Degree Down Sleeping Bag',
      },
      {
        name: 'Jetboil Flash',
        amazonSearchQuery: 'Jetboil Flash Camping Stove Cooking System',
        category: 'Stove',
        why: 'Boils 2 cups in 100 seconds. All-in-one system with pot, burner, and igniter. Essential for morning coffee and dehydrated meals.',
        priceRange: '$110-130',
        alternative: 'MSR PocketRocket 2 ($50) for lighter weight',
        altSearchQuery: 'MSR PocketRocket 2 Ultralight Backpacking Stove',
      },
      {
        name: 'BearVault BV500',
        amazonSearchQuery: 'BearVault BV500 Bear Resistant Food Canister',
        category: 'Food Storage',
        why: 'Required in many parks including Yosemite and Sequoia. Fits 7 days of food. Clear design lets you see contents. Bear-tested and approved.',
        priceRange: '$75-90',
        alternative: 'Ursack Major ($100) where allowed - lighter but requires tree tie',
        altSearchQuery: 'Ursack Major Bear Sack',
      },
      {
        name: 'Helinox Chair Zero',
        amazonSearchQuery: 'Helinox Chair Zero Ultralight Camping Chair',
        category: 'Comfort',
        why: 'Weighs just 1 lb but supports 265 lbs. Packs smaller than a water bottle. Game-changer for campsite comfort after long hikes.',
        priceRange: '$150-170',
        alternative: 'REI Flexlite Air ($100)',
        altSearchQuery: 'REI Co-op Flexlite Air Chair',
      },
    ],
  },
  {
    slug: 'clothing',
    name: 'Clothing Layers',
    icon: '🧥',
    description: 'Dress for mountain weather.',
    items: [
      {
        name: 'Patagonia Capilene Cool Daily',
        amazonSearchQuery: 'Patagonia Capilene Cool Daily Shirt',
        category: 'Base Layer',
        why: 'Moisture-wicking, quick-dry, sun protection (UPF 50). Works in hot and cool weather. No cotton - it holds sweat and makes you cold.',
        priceRange: '$45-55',
        alternative: 'REI Sahara ($35)',
        altSearchQuery: 'REI Co-op Sahara Long-Sleeve Shirt',
      },
      {
        name: 'Patagonia Nano Puff',
        amazonSearchQuery: 'Patagonia Nano Puff Insulated Jacket',
        category: 'Insulation',
        why: 'Synthetic insulation works when wet. Packs into its own pocket. Warm enough for most 3-season conditions. Layer under rain shell when cold.',
        priceRange: '$200-230',
        alternative: 'Uniqlo Ultra Light Down ($60) for budget',
        altSearchQuery: 'Uniqlo Ultra Light Down Jacket',
      },
      {
        name: 'Arc\'teryx Beta LT',
        amazonSearchQuery: 'Arcteryx Beta LT Gore-Tex Jacket',
        category: 'Rain Shell',
        why: 'Gore-Tex protection in a lightweight, packable jacket. Hood fits over helmets, pit zips for ventilation. The best all-around rain jacket.',
        priceRange: '$400-475',
        alternative: 'REI Rainier ($100) for 90% of the performance at 25% the price',
        altSearchQuery: 'REI Co-op Rainier Rain Jacket',
      },
      {
        name: 'prAna Stretch Zion Pants',
        amazonSearchQuery: 'prAna Stretch Zion Straight Pants',
        category: 'Pants',
        why: 'Stretchy, quick-dry, roll-up legs for wading. Gusseted crotch for mobility. Look good enough for town after the trail.',
        priceRange: '$80-95',
        alternative: 'REI Sahara pants ($70)',
        altSearchQuery: 'REI Co-op Sahara Convertible Pants',
      },
      {
        name: 'Darn Tough Hiker Micro Crew',
        amazonSearchQuery: 'Darn Tough Hiker Micro Crew Cushion Socks',
        category: 'Socks',
        why: 'Merino wool prevents blisters and controls odor. Lifetime warranty - they\'ll replace them forever. Buy several pairs.',
        priceRange: '$25-30',
        alternative: 'Smartwool Hike Light ($22)',
        altSearchQuery: 'Smartwool Hike Light Cushion Crew Socks',
      },
      {
        name: 'Outdoor Research Sun Runner Cap',
        amazonSearchQuery: 'Outdoor Research Sun Runner Cap UPF 50',
        category: 'Sun Protection',
        why: 'UPF 50 protection with removable cape that covers neck and ears. Looks dorky, works brilliantly. Essential in desert parks.',
        priceRange: '$35-45',
        alternative: 'Any wide-brim hat with chin strap',
        altSearchQuery: '',
      },
    ],
  },
  {
    slug: 'photography',
    name: 'Photography Gear',
    icon: '📷',
    description: 'Capture park memories.',
    items: [
      {
        name: 'Sony A7C II',
        amazonSearchQuery: 'Sony A7C II Full Frame Mirrorless Camera Body',
        category: 'Camera',
        why: 'Full-frame quality in a compact body. Excellent low-light for sunrise/sunset. Flip screen for creative angles. Great balance of features and portability.',
        priceRange: '$2,200-2,400',
        alternative: 'Sony A6700 ($1,400) for APS-C or Fujifilm X-T5 ($1,700)',
        altSearchQuery: 'Sony A6700 Mirrorless Camera',
      },
      {
        name: 'Sony 16-35mm f/2.8 GM II',
        amazonSearchQuery: 'Sony FE 16-35mm f2.8 GM II Lens',
        category: 'Wide Angle',
        why: 'The landscape lens. Sharp corner-to-corner, fast aperture for astro. Light for a pro zoom. Worth every penny for serious landscape work.',
        priceRange: '$2,200-2,500',
        alternative: 'Tamron 17-28mm f/2.8 ($900) for budget wide angle',
        altSearchQuery: 'Tamron 17-28mm f2.8 Di III RXD Sony E Mount',
      },
      {
        name: 'Sony 100-400mm f/4.5-5.6 GM',
        amazonSearchQuery: 'Sony FE 100-400mm f4.5-5.6 GM OSS Lens',
        category: 'Telephoto',
        why: 'Essential for wildlife from safe distances. Excellent sharpness, fast autofocus, internal zoom. Heavy but worth it for bison, bears, and birds.',
        priceRange: '$2,400-2,700',
        alternative: 'Sony 70-350mm ($1,000) for APS-C or Sigma 100-400mm ($900)',
        altSearchQuery: 'Sigma 100-400mm f5-6.3 DG DN OS Sony E Mount',
      },
      {
        name: 'Peak Design Travel Tripod',
        amazonSearchQuery: 'Peak Design Travel Tripod Carbon Fiber',
        category: 'Tripod',
        why: 'Compact design packs incredibly small but extends to full height. Ball head included. The best travel tripod on the market.',
        priceRange: '$350-400',
        alternative: 'Manfrotto Befree ($180)',
        altSearchQuery: 'Manfrotto Befree Advanced Travel Tripod',
      },
      {
        name: 'NiSi V6 Filter Kit',
        amazonSearchQuery: 'NiSi V6 100mm Filter Holder Kit with CPL',
        category: 'Filters',
        why: 'Graduated ND filters balance bright skies with dark foregrounds. Polarizer cuts glare from water and enhances skies. Essential for landscape pros.',
        priceRange: '$350-450',
        alternative: 'K&F Concept filter set ($100) for beginners',
        altSearchQuery: 'K&F Concept ND Filter Kit 67mm',
      },
      {
        name: 'Peak Design Everyday Backpack 30L',
        amazonSearchQuery: 'Peak Design Everyday Backpack V2 30L',
        category: 'Camera Bag',
        why: 'Customizable dividers, quick side access, weatherproof. Fits camera gear plus layers and snacks. Doesn\'t scream "expensive camera inside."',
        priceRange: '$280-300',
        alternative: 'Lowepro Flipside ($100)',
        altSearchQuery: 'Lowepro Flipside 400 AW Camera Backpack',
      },
    ],
  },
  {
    slug: 'safety',
    name: 'Safety & Emergency',
    icon: '🆘',
    description: 'Be prepared for the unexpected.',
    items: [
      {
        name: 'Counter Assault Bear Spray',
        amazonSearchQuery: 'Counter Assault Bear Deterrent Spray 10.2oz',
        category: 'Wildlife',
        why: 'Required in grizzly country (Yellowstone, Glacier, Grand Teton). 32-foot range, 7-second spray time. Practice drawing it before your trip.',
        priceRange: '$40-55',
        alternative: 'UDAP Bear Spray ($35)',
        altSearchQuery: 'UDAP Bear Spray with Hip Holster',
      },
      {
        name: 'Adventure Medical Kits Ultralight .7',
        amazonSearchQuery: 'Adventure Medical Kits Ultralight Watertight .7 First Aid Kit',
        category: 'First Aid',
        why: 'Comprehensive kit for 1-4 people. Includes blister care, wound treatment, medications. Add personal prescriptions and extra moleskin.',
        priceRange: '$35-45',
        alternative: 'Build your own with Leukotape, ibuprofen, and bandages',
        altSearchQuery: '',
      },
      {
        name: 'Sawyer Squeeze Water Filter',
        amazonSearchQuery: 'Sawyer Products Squeeze Water Filtration System',
        category: 'Water Treatment',
        why: 'Filters to 0.1 microns - removes bacteria and protozoa. Lightweight, no pumping needed. Backflush to maintain flow rate.',
        priceRange: '$35-45',
        alternative: 'Aquamira drops ($15) as backup or for viruses',
        altSearchQuery: 'Aquamira Water Treatment Drops',
      },
      {
        name: 'SOL Emergency Bivvy',
        amazonSearchQuery: 'SOL Emergency Bivvy Survival Sleeping Bag',
        category: 'Shelter',
        why: 'Reflects 90% of body heat. Weighs 3.8 oz. Could save your life if you\'re stuck overnight. Every pack should have one.',
        priceRange: '$15-25',
        alternative: 'Space blanket ($5) is better than nothing',
        altSearchQuery: 'Emergency Mylar Space Blanket',
      },
      {
        name: 'Victorinox Swiss Army Knife',
        amazonSearchQuery: 'Victorinox Swiss Army Classic SD Pocket Knife',
        category: 'Tools',
        why: 'Blade, scissors, tweezers for splinters, can opener. Endless uses on the trail. The Classic SD fits on a keychain.',
        priceRange: '$20-40',
        alternative: 'Leatherman Squirt ($40) for pliers',
        altSearchQuery: 'Leatherman Squirt PS4 Multitool',
      },
      {
        name: 'ACR ResQLink 400',
        amazonSearchQuery: 'ACR ResQLink 400 Personal Locator Beacon',
        category: 'Emergency Beacon',
        why: 'Personal locator beacon sends distress signal to rescue services worldwide. No subscription required. For serious backcountry only.',
        priceRange: '$250-300',
        alternative: 'Garmin inReach if you want two-way messaging',
        altSearchQuery: 'Garmin inReach Mini 2 Satellite Communicator',
      },
    ],
  },
  {
    slug: 'wildlife',
    name: 'Wildlife Viewing',
    icon: '🦬',
    description: 'Safely observe park wildlife.',
    items: [
      {
        name: 'Vortex Viper HD 10x42',
        amazonSearchQuery: 'Vortex Optics Viper HD 10x42 Binoculars',
        category: 'Binoculars',
        why: '10x magnification is ideal for wildlife at safe distances. HD glass for sharp, bright images. Lifetime warranty. The sweet spot of quality and value.',
        priceRange: '$400-500',
        alternative: 'Nikon Monarch 5 ($300) or Celestron Nature DX ($130) for budget',
        altSearchQuery: 'Nikon Monarch M5 10x42 Binoculars',
      },
      {
        name: 'Vortex Razor HD 27-60x85',
        amazonSearchQuery: 'Vortex Optics Razor HD 27-60x85 Angled Spotting Scope',
        category: 'Spotting Scope',
        why: 'For serious wildlife watching in Yellowstone, Denali, or Lamar Valley. Window-mount adapter available. See wolves and bears from miles away.',
        priceRange: '$1,800-2,200',
        alternative: 'Vortex Diamondback ($400) for casual use',
        altSearchQuery: 'Vortex Optics Diamondback HD Spotting Scope',
      },
      {
        name: 'Sibley Birds West / East',
        amazonSearchQuery: 'Sibley Field Guide to Birds of Eastern North America',
        category: 'Field Guide',
        why: 'The definitive bird identification guide. Illustrations show key features better than photos. Regional editions are easier to carry.',
        priceRange: '$25-30',
        alternative: 'Merlin Bird ID app (free) for quick IDs',
        altSearchQuery: '',
      },
      {
        name: 'National Audubon Society Field Guide',
        amazonSearchQuery: 'National Audubon Society Field Guide to North American Mammals',
        category: 'Mammals',
        why: 'Identify everything from pikas to mountain lions. Color photos and range maps. Small enough for day packs.',
        priceRange: '$20-25',
        alternative: 'iNaturalist app (free) for all species',
        altSearchQuery: '',
      },
      {
        name: 'Joby GorillaPod 3K',
        amazonSearchQuery: 'Joby GorillaPod 3K Flexible Tripod',
        category: 'Tripod',
        why: 'Wraps around branches and railings for stable binocular or camera use. Light and packable. Great for digiscoping through spotting scopes.',
        priceRange: '$50-60',
        alternative: 'Phone mount adapter ($15) for binocular photography',
        altSearchQuery: 'Universal Phone Adapter Mount for Binoculars',
      },
      {
        name: 'Thermacell E55 Rechargeable',
        amazonSearchQuery: 'Thermacell E55 Rechargeable Mosquito Repeller',
        category: 'Bug Protection',
        why: 'Creates 20-foot mosquito-free zone. Essential for Alaska parks and anywhere during bug season. Rechargeable, no open flame.',
        priceRange: '$40-50',
        alternative: 'Picaridin spray ($10) as backup',
        altSearchQuery: 'Sawyer Products Picaridin Insect Repellent Spray',
      },
    ],
  },
];

const tenEssentials = [
  { item: 'Navigation', gear: 'Map, compass, GPS device' },
  { item: 'Sun protection', gear: 'Sunscreen, sunglasses, hat' },
  { item: 'Insulation', gear: 'Extra clothing layers' },
  { item: 'Illumination', gear: 'Headlamp + extra batteries' },
  { item: 'First aid', gear: 'Kit + personal meds' },
  { item: 'Fire', gear: 'Lighter + waterproof matches' },
  { item: 'Repair tools', gear: 'Knife, duct tape, cord' },
  { item: 'Nutrition', gear: 'Extra day of food' },
  { item: 'Hydration', gear: 'Extra water + filter' },
  { item: 'Emergency shelter', gear: 'Bivy or space blanket' },
];
---

<BaseLayout
  title="Recommended Gear for National Parks"
  description="The best gear for national park adventures. Expert recommendations for hiking, camping, photography, and wildlife viewing."
>
  <!-- Hero -->
  <section class="bg-primary text-white py-16">
    <div class="container-site text-center">
      <h1 class="text-4xl md:text-5xl font-display font-bold mb-4">
        Recommended Gear
      </h1>
      <p class="text-xl text-white/90 max-w-2xl mx-auto">
        The right gear makes all the difference. Here's what experienced park visitors recommend.
      </p>
    </div>
  </section>

  <!-- 10 Essentials Banner -->
  <section class="bg-secondary/10 py-8">
    <div class="container-site">
      <h2 class="text-xl font-display font-bold text-gray-900 mb-4 text-center">
        The Ten Essentials - Never Hike Without Them
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-3 max-w-4xl mx-auto">
        {tenEssentials.map((essential, i) => (
          <div class="bg-white rounded-lg p-3 shadow-sm">
            <div class="text-sm font-semibold text-primary">{i + 1}. {essential.item}</div>
            <div class="text-xs text-gray-500">{essential.gear}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="bg-white py-4 border-b sticky top-16 md:top-20 z-40">
    <div class="container-site">
      <div class="flex gap-3 overflow-x-auto pb-2 -mb-2">
        {gearCategories.map((cat) => (
          <a
            href={`#${cat.slug}`}
            class="bg-gray-100 px-4 py-2 rounded-full text-sm font-medium text-gray-700 hover:bg-primary hover:text-white transition-colors whitespace-nowrap"
          >
            {cat.icon} {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Gear Categories -->
  <section class="section-padding bg-gray-50">
    <div class="container-site">
      <div class="space-y-16">
        {gearCategories.map((category) => (
          <div id={category.slug} class="scroll-mt-32">
            <div class="flex items-center gap-3 mb-6">
              <span class="text-4xl">{category.icon}</span>
              <div>
                <h2 class="text-3xl font-display font-bold text-gray-900">
                  {category.name}
                </h2>
                <p class="text-gray-600">{category.description}</p>
              </div>
            </div>

            <div class="grid md:grid-cols-2 gap-4">
              {category.items.map((item) => (
                <div class="bg-white rounded-xl shadow-sm p-5 hover:shadow-md transition-shadow">
                  <div class="flex justify-between items-start mb-2">
                    <div>
                      <span class="text-xs bg-primary/10 text-primary px-2 py-1 rounded font-medium">
                        {item.category}
                      </span>
                    </div>
                    <span class="text-sm font-semibold text-gray-900">
                      {item.priceRange}
                    </span>
                  </div>
                  <h3 class="text-lg font-semibold text-gray-900 mt-2">
                    {item.name}
                  </h3>
                  <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                    {item.why}
                  </p>
                  <p class="text-xs text-gray-500 mt-3 pt-3 border-t border-gray-100">
                    <span class="font-medium">Budget alternative:</span> {item.alternative}
                  </p>
                  {amazonTag && (
                    <div class="flex flex-wrap gap-3 mt-3">
                      <a
                        href={amazonUrl(item.amazonSearchQuery || item.name)}
                        target="_blank"
                        rel="nofollow sponsored noopener"
                        class="inline-block text-sm font-medium text-primary hover:text-primary/80 transition-colors"
                      >
                        Check Price on Amazon &rarr;
                      </a>
                      {item.altSearchQuery && (
                        <a
                          href={amazonUrl(item.altSearchQuery)}
                          target="_blank"
                          rel="nofollow sponsored noopener"
                          class="inline-block text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors"
                        >
                          Budget Alternative &rarr;
                        </a>
                      )}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ad -->
  <div class="container-site">
    <AdSlot slot="inline" />
  </div>

  <!-- Pro Tips -->
  <section class="section-padding bg-white">
    <div class="container-site">
      <h2 class="text-2xl font-display font-bold text-gray-900 mb-8 text-center">
        Gear Pro Tips
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="bg-gray-50 rounded-lg p-6">
          <div class="text-2xl mb-3">🧪</div>
          <h3 class="font-semibold text-gray-900 mb-2">Test Before You Go</h3>
          <p class="text-sm text-gray-600">
            Break in new boots with local hikes. Set up your tent in the backyard. Discovering gear problems on the trail ruins trips.
          </p>
        </div>
        <div class="bg-gray-50 rounded-lg p-6">
          <div class="text-2xl mb-3">💎</div>
          <h3 class="font-semibold text-gray-900 mb-2">Buy Quality Once</h3>
          <p class="text-sm text-gray-600">
            A quality tent or sleeping bag lasts 10-20 years. Cheap gear fails when you need it most. Invest in the big items.
          </p>
        </div>
        <div class="bg-gray-50 rounded-lg p-6">
          <div class="text-2xl mb-3">🏷️</div>
          <h3 class="font-semibold text-gray-900 mb-2">REI Used Gear</h3>
          <p class="text-sm text-gray-600">
            REI Garage sales and re/supply program offer quality used gear at 30-50% off. Patagonia Worn Wear is another great source.
          </p>
        </div>
        <div class="bg-gray-50 rounded-lg p-6">
          <div class="text-2xl mb-3">📦</div>
          <h3 class="font-semibold text-gray-900 mb-2">Rent First</h3>
          <p class="text-sm text-gray-600">
            REI, local gear shops, and online services rent backpacking gear. Try before you buy for expensive items like tents and packs.
          </p>
        </div>
        <div class="bg-gray-50 rounded-lg p-6">
          <div class="text-2xl mb-3">⚖️</div>
          <h3 class="font-semibold text-gray-900 mb-2">Weight Matters</h3>
          <p class="text-sm text-gray-600">
            For backpacking, every ounce counts. Weigh your gear and ruthlessly cut what you don't need. Base weight under 15 lbs is the goal.
          </p>
        </div>
        <div class="bg-gray-50 rounded-lg p-6">
          <div class="text-2xl mb-3">📋</div>
          <h3 class="font-semibold text-gray-900 mb-2">Make Checklists</h3>
          <p class="text-sm text-gray-600">
            Keep packing lists for different trip types. Update after each trip with lessons learned. Never forget essentials again.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Affiliate Disclosure -->
  <section class="bg-gray-100 py-6">
    <div class="container-site">
