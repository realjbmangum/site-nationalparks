---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getParksWithProducts, getParkBySlug, type Park } from '../../lib/db';

const runtime = Astro.locals.runtime.env;
const db = runtime.DB;

const parksWithProducts = await getParksWithProducts(db);

// Fetch park details for each park with products
const parks: (Park & { product_count: number })[] = [];
for (const { park_slug, product_count } of parksWithProducts) {
  const park = await getParkBySlug(db, park_slug);
  if (park) {
    parks.push({ ...park, product_count });
  }
}
---

<BaseLayout
  title="National Park Merchandise"
  description="Shop unique national park badge merchandise. Mugs, t-shirts, stickers, posters, and totes featuring all 63 US national parks."
>
  <!-- Hero -->
  <section class="bg-primary text-white py-16 md:py-24">
    <div class="container-site text-center">
      <h1 class="text-4xl md:text-5xl font-display font-bold mb-4">
        National Park Badge Merchandise
      </h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto">
        Wear your adventure. Unique badge designs for all 63 US national parks on mugs, shirts, stickers, posters, and totes.
      </p>
    </div>
  </section>

  <div class="container-site section-padding">
    {parks.length === 0 ? (
      <div class="text-center py-16">
        <p class="text-gray-500 text-lg mb-4">No merchandise available yet.</p>
        <p class="text-gray-400">Check back soon — we're adding park badge products.</p>
      </div>
    ) : (
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-6">
        {parks.map((park) => (
          <a
            href={`/shop/${park.slug}`}
            class="group block bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow overflow-hidden"
          >
            <div class="aspect-square bg-gray-100 overflow-hidden">
              {park.photo_url ? (
                <img
                  src={park.photo_url}
                  alt={`${park.name} badge`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400">
                  <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              )}
            </div>
            <div class="p-3">
              <h2 class="font-display font-semibold text-sm text-gray-900 group-hover:text-primary transition-colors">
                {park.name}
              </h2>
              <p class="text-xs text-gray-500 mt-1">
                {park.product_count} {park.product_count === 1 ? 'product' : 'products'}
              </p>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
