---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getParkBySlug, getProductsByPark, type PrintfulProduct } from '../../lib/db';

const runtime = Astro.locals.runtime.env;
const db = runtime.DB;

const { park: parkSlug } = Astro.params;
const park = await getParkBySlug(db, parkSlug!);

if (!park) {
  return Astro.redirect('/shop');
}

const products = await getProductsByPark(db, parkSlug!);

function formatPrice(cents: number): string {
  return `$${(cents / 100).toFixed(2)}`;
}

const productTypeLabels: Record<string, string> = {
  mug: 'Mug',
  shirt: 'T-Shirt',
  sticker: 'Sticker',
  poster: 'Poster',
  tote: 'Tote Bag',
};
---

<BaseLayout
  title={`${park.name} Merchandise`}
  description={`Shop ${park.name} National Park badge merchandise. Mugs, shirts, stickers, posters, and totes.`}
  image={park.photo_url || undefined}
>
  <!-- Hero -->
  <section class="relative bg-primary text-white py-12 md:py-20">
    <div class="container-site">
      <nav class="text-white/70 text-sm mb-4">
        <a href="/" class="hover:text-white">Home</a>
        <span class="mx-2">/</span>
        <a href="/shop" class="hover:text-white">Shop</a>
        <span class="mx-2">/</span>
        <span class="text-white">{park.name}</span>
      </nav>
      <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
        {park.photo_url && (
          <img
            src={park.photo_url}
            alt={`${park.name} badge`}
            class="w-24 h-24 md:w-32 md:h-32 rounded-xl object-cover shadow-lg"
          />
        )}
        <div>
          <h1 class="text-3xl md:text-4xl font-display font-bold mb-2">
            {park.name} Merchandise
          </h1>
          <p class="text-white/80">
            {park.state} &middot; {products.length} {products.length === 1 ? 'product' : 'products'} available
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="container-site section-padding">
    {products.length === 0 ? (
      <div class="text-center py-16">
        <p class="text-gray-500 text-lg mb-4">No products available for this park yet.</p>
        <div class="flex justify-center gap-4">
          <a href="/shop" class="btn-primary">Back to Shop</a>
          <a href={`/parks/${park.slug}`} class="btn-outline">View Park Details</a>
        </div>
      </div>
    ) : (
      <>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {products.map((product) => (
            <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow overflow-hidden">
              <div class="aspect-square bg-gray-100 overflow-hidden">
                {product.mockup_url ? (
                  <img
                    src={product.mockup_url}
                    alt={product.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-400">
                    <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-4">
                <span class="text-xs font-medium text-primary/70 uppercase tracking-wide">
                  {productTypeLabels[product.product_type] || product.product_type}
                </span>
                <h2 class="font-display font-semibold text-gray-900 mt-1">{product.name}</h2>
                <div class="flex items-center justify-between mt-3">
                  <span class="text-lg font-bold text-gray-900">{formatPrice(product.price_cents)}</span>
                  {product.checkout_url ? (
                    <a
                      href={product.checkout_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-primary text-sm px-4 py-2"
                    >
                      Buy Now
                    </a>
                  ) : (
                    <span class="text-sm text-gray-400">Coming Soon</span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="flex flex-wrap justify-center gap-4 mt-12">
          <a href="/shop" class="btn-outline">Back to Shop</a>
          <a href={`/parks/${park.slug}`} class="btn-primary">View Park Details</a>
        </div>
      </>
    )}
  </div>
</BaseLayout>
