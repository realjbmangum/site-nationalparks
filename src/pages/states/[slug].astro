---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ParkCard from '../../components/ParkCard.astro';
import {
  getParksByStateName,
  getStatesWithCounts,
  stateSlugToName,
  stateNameToSlug,
  US_STATES,
} from '../../lib/db';

// Get D1 database from Cloudflare runtime
const db = Astro.locals.runtime.env.DB;

// Get state slug from URL
const { slug } = Astro.params;

// Convert slug to state name
const stateData = US_STATES[slug!];
const stateName = stateData?.name || stateSlugToName(slug!);

// Fetch parks for this state
const parks = await getParksByStateName(db, stateName);

// If no parks found, redirect to 404
if (parks.length === 0) {
  return Astro.redirect('/404');
}

// Get all states with counts for sidebar
const allStates = await getStatesWithCounts(db);

// Default hero image based on state (generic landscape)
const heroImage = parks[0]?.photo_url || 'https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=1920&q=80';

// Schema.org markup
const stateSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `National Parks in ${stateName}`,
  description: `Explore ${parks.length} national park${parks.length !== 1 ? 's' : ''} in ${stateName}`,
  numberOfItems: parks.length,
  itemListElement: parks.map((park, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'TouristAttraction',
      name: `${park.name} National Park`,
      url: `https://bestusnationalparks.com/parks/${park.slug}`,
    },
  })),
};
---

<BaseLayout
  title={`National Parks in ${stateName}`}
  description={`Discover ${parks.length} national park${parks.length !== 1 ? 's' : ''} in ${stateName}. Plan your visit with guides, tips, and essential information.`}
  image={heroImage}
  schema={stateSchema}
>
  <!-- Hero Section -->
  <section class="relative h-[40vh] min-h-[300px] overflow-hidden">
    <img
      src={heroImage}
      alt={`${stateName} landscape`}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent" />

    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-12">
      <div class="container-site">
        <nav class="text-white/80 text-sm mb-4">
          <a href="/" class="hover:text-white">Home</a>
          <span class="mx-2">/</span>
          <a href="/parks" class="hover:text-white">Parks</a>
          <span class="mx-2">/</span>
          <span class="text-white">States</span>
        </nav>
        <h1 class="text-4xl md:text-5xl font-display font-bold text-white mb-2">
          National Parks in {stateName}
        </h1>
        <p class="text-xl text-secondary font-medium">
          {parks.length} Park{parks.length !== 1 ? 's' : ''} to Explore
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="section-padding bg-gray-50">
    <div class="container-site">
      <div class="grid lg:grid-cols-4 gap-8">
        <!-- Parks Grid -->
        <div class="lg:col-span-3">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {parks.map((park) => (
              <ParkCard park={park} />
            ))}
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="sticky top-24">
            <!-- State Stats -->
            <div class="bg-white rounded-xl shadow-md p-6 mb-6">
              <h2 class="font-display font-bold text-lg text-gray-900 mb-4">
                {stateName} at a Glance
              </h2>
              <dl class="space-y-3 text-sm">
                <div class="flex justify-between">
                  <dt class="text-gray-600">National Parks</dt>
                  <dd class="font-medium text-gray-900">{parks.length}</dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-gray-600">Total Annual Visitors</dt>
                  <dd class="font-medium text-gray-900">
                    {parks.reduce((sum, p) => sum + (p.annual_visitors || 0), 0) >= 1000000
                      ? `${(parks.reduce((sum, p) => sum + (p.annual_visitors || 0), 0) / 1000000).toFixed(1)}M`
                      : `${Math.round(parks.reduce((sum, p) => sum + (p.annual_visitors || 0), 0) / 1000)}K`}
                  </dd>
                </div>
              </dl>
            </div>

            <!-- Other States -->
            <div class="bg-white rounded-xl shadow-md p-6">
              <h2 class="font-display font-bold text-lg text-gray-900 mb-4">
                Browse by State
              </h2>
              <div class="space-y-2 max-h-64 overflow-y-auto">
                {allStates.map((s) => (
                  <a
                    href={`/states/${stateNameToSlug(s.state)}`}
                    class={`block px-3 py-2 rounded-lg text-sm transition-colors ${
                      s.state === stateName
                        ? 'bg-primary text-white'
                        : 'hover:bg-gray-100 text-gray-700'
                    }`}
                  >
                    {s.state}
                    <span class={s.state === stateName ? 'text-white/80' : 'text-gray-400'}>
                      ({s.count})
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Explore More CTA -->
  <section class="py-12 bg-white border-t">
    <div class="container-site text-center">
      <h2 class="text-2xl font-display font-bold text-gray-900 mb-4">
        Explore More National Parks
      </h2>
      <p class="text-gray-600 mb-6 max-w-xl mx-auto">
        Discover all 63 national parks across the United States or find parks by region.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/parks" class="btn-primary">View All Parks</a>
        <a href="/map" class="btn-secondary">Interactive Map</a>
      </div>
    </div>
  </section>
</BaseLayout>
